# ---------------------------------------------------------------------------
# ReAdmitIQ backend environment. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------
APP_ENV=development

# Neon Postgres. Use the pooled connection string and keep sslmode=require.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/readmitiq?sslmode=require

# openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma separated. Set the real Vercel origin at 14:00, never "*".
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

MODEL_DIR=app/artifacts
RISK_LOW_MAX=0.30
RISK_MED_MAX=0.60

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@readmitiq.io
SMTP_FROM_NAME=ReAdmitIQ

LOGIN_RATE_LIMIT=5/minute
